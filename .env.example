# Financial Research Agent local configuration reference.
# FRA means Financial Research Agent.
# CLI commands load .env from the current working directory. Existing process and
# container environment variables take precedence. Set PYTHON_DOTENV_DISABLED=1 to disable it.

FRA_ENV=local
FRA_HOME=
# Default structured store. Use local-json only as an explicit compatibility/migration path.
FRA_STORAGE_PROVIDER=sqlite
FRA_RETRIEVAL_PROVIDER=local-vector
FRA_RETRIEVAL_TOP_K=5
FRA_RETRIEVAL_MIN_SCORE=0.0
FRA_BACKGROUND_MAX_CONCURRENT_RESEARCH_RUNS=1
FRA_PROMPT_BUDGET_INPUT_TOKENS=16000
FRA_PROMPT_BUDGET_OUTPUT_TOKENS=1024
FRA_EMBEDDING_CACHE_ENABLED=true
# Keep false for direct local runs. Compose publishes ports on 127.0.0.1 and enables
# the container's internal 0.0.0.0 bind explicitly.
FRA_ALLOW_REMOTE_BIND=false

# Internal A2A specialist transport is the only research runtime. Docker Compose supplies
# service URLs automatically. FRA_A2A_ENABLED controls each specialist server process; it
# does not enable a local fallback. Direct Python development expects ports 8002-8005.
FRA_A2A_ENABLED=false
FRA_A2A_LOCAL_ONLY=true
FRA_A2A_API_KEY=
FRA_A2A_MAX_CONCURRENT_TASKS=1
FRA_A2A_MAX_QUEUED_TASKS=8
FRA_A2A_MAX_INPUT_CHARS=4000
FRA_A2A_PUBLIC_BASE_URL=http://127.0.0.1:8001
FRA_A2A_PORT=8001
FRA_A2A_FINANCIAL_REPORT_URL=http://127.0.0.1:8002
FRA_A2A_STOCK_URL=http://127.0.0.1:8003
FRA_A2A_CONTEXT_URL=http://127.0.0.1:8004
FRA_A2A_SYNTHESIS_URL=http://127.0.0.1:8005
FRA_A2A_DELEGATION_TIMEOUT_SECONDS=120
FRA_A2A_DELEGATION_MAX_ATTEMPTS=2
# Opt-in live A2A smoke; requires real SEC and Alpha Vantage configuration.
FRA_A2A_LIVE_SMOKE_TEST=0

# Optional MCP stdio interface. The application must already be running on this loopback URL.
FRA_MCP_APP_BASE_URL=http://127.0.0.1:8000

FRA_LLM_PROVIDER=offline-test
FRA_LLM_MODEL=offline-test
FRA_LLM_BASE_URL=http://127.0.0.1:8080/v1
FRA_LLM_LOCAL_RUNTIME=llama.cpp
FRA_LLM_TIMEOUT_SECONDS=90

# Docker Compose starts the full agent topology with offline-test by default.
# CPU/CUDA profiles add one optional local model runtime.
# FRA_CPU_MODEL=ggml-org/gemma-3-1b-it-GGUF:Q4_K_M
# FRA_CUDA_MODEL=unsloth/Mistral-Small-3.2-24B-Instruct-2506-GGUF:UD-Q4_K_XL
# FRA_LLAMA_CPP_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# FRA_LLAMA_CPP_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# FRA_HUGGINGFACE_CACHE=.docker/huggingface
# FRA_LLAMA_PORT=8080
# FRA_APP_PORT=8000
# FRA_CPU_CTX_SIZE=8192
# FRA_CUDA_CTX_SIZE=32768
# FRA_LLAMA_GPU_LAYERS=99

# Optional hosted OpenAI provider. Leave the key blank unless you explicitly select
# FRA_LLM_PROVIDER=openai. OPENAI_API_KEY is also supported as a fallback alias.
FRA_OPENAI_API_KEY=
FRA_OPENAI_BASE_URL=https://api.openai.com/v1
FRA_OPENAI_ORGANIZATION=
FRA_OPENAI_PROJECT=

# Optional direct Anthropic provider. Anthropic does not provide embeddings through this app.
# ANTHROPIC_API_KEY is supported as a fallback alias.
FRA_ANTHROPIC_API_KEY=
FRA_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
FRA_ANTHROPIC_API_VERSION=2023-06-01

# Optional direct Gemini provider. GEMINI_API_KEY is supported as a fallback alias.
FRA_GEMINI_API_KEY=
FRA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional external LiteLLM proxy. A local proxy may run without a key; configure one when
# the proxy requires bearer authentication. The app does not start or manage LiteLLM.
FRA_LITELLM_API_KEY=
FRA_LITELLM_BASE_URL=http://127.0.0.1:4000/v1

FRA_CHAT_PROVIDER=
FRA_CHAT_MODEL=
FRA_CHAT_HISTORY_RECENT_TURNS=6
FRA_CHAT_HISTORY_SUMMARY_MAX_CHARS=1200

FRA_COMPANY_LOOKUP_PROVIDER=sec
FRA_COMPANY_LOOKUP_CACHE_TTL_DAYS=30
# Replace this placeholder with an identifying application name and a real contact address
# before live SEC ingestion or `scenario-run novo-nordisk`.
FRA_SEC_USER_AGENT=financial-research-agent/0.1 local-research contact@financial-research-agent.local
FRA_MARKET_DATA_PROVIDER=alpha-vantage
FRA_MARKET_DATA_CACHE_TTL_DAYS=1
FRA_ALPHA_VANTAGE_API_KEY=
FRA_FINANCIAL_STATEMENT_PROVIDER=sec-companyfacts
FRA_FINANCIAL_STATEMENT_CACHE_TTL_DAYS=30

# SEC filing/document ingestion stores raw documents and extracted text under FRA_HOME.
# Keep the max document size explicit so large PDFs or unexpected archives fail safely.
FRA_FILING_PROVIDER=sec-edgar
FRA_FILING_CACHE_TTL_DAYS=30
FRA_FILING_MAX_DOCUMENT_BYTES=8000000

FRA_TOOL_CALLING_PROVIDER=
FRA_TOOL_CALLING_MODEL=

FRA_STRUCTURED_OUTPUT_PROVIDER=
FRA_STRUCTURED_OUTPUT_MODEL=

FRA_STREAMING_PROVIDER=
FRA_STREAMING_MODEL=

FRA_EMBEDDING_PROVIDER=disabled
FRA_EMBEDDING_MODEL=

# Set to 1 to allow the optional local endpoint smoke test to use FRA_LLM_BASE_URL.
FRA_LOCAL_SMOKE_TEST=0

# Set to 1 to allow the optional hosted OpenAI smoke test to use real credentials.
FRA_OPENAI_SMOKE_TEST=0

# Opt-in network smoke tests for additional hosted/gateway providers.
FRA_ANTHROPIC_SMOKE_TEST=0
FRA_GEMINI_SMOKE_TEST=0
FRA_LITELLM_SMOKE_TEST=0
